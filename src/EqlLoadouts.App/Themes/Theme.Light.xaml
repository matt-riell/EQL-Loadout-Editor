    <SolidColorBrush x:Key="CanvasWindowBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CanvasInventoryBrush" Color="#F8E8C4"/>
    <SolidColorBrush x:Key="CanvasBankBrush" Color="#D7E6F8"/>
    <SolidColorBrush x:Key="CanvasSelectedBrush" Color="#7A3E0C"/>
    <SolidColorBrush x:Key="CanvasAnchorBrush" Color="#C2621D"/>
    <SolidColorBrush x:Key="CanvasLabelBrush" Color="#101216"/>
    <SolidColorBrush x:Key="CanvasStrokeBrush" Color="#2C3542"/>

    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#1C1E22"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#1C1E22"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#667085"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#8C6239"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
