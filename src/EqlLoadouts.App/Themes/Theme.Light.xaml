    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAlt" Color="#F2F3F5"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#D6D9DF"/>
    <SolidColorBrush x:Key="BorderHoverBrush" Color="#A9AFB9"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1C1E22"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#667085"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#8C6239"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#744F2C"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#F4EADF"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#EEF0F3"/>
