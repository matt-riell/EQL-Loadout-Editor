<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackground" Color="#141519"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="#18191D"/>
    <SolidColorBrush x:Key="Surface" Color="#1D1E23"/>
    <SolidColorBrush x:Key="SurfaceAlt" Color="#26282E"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#373A42"/>
    <SolidColorBrush x:Key="BorderHoverBrush" Color="#565A64"/>
    <SolidColorBrush x:Key="TextBrush" Color="#ECEDEF"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#9A9EA8"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#C9A45C"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#D8B676"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#1A140C"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#3A3326"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#2A2C33"/>
