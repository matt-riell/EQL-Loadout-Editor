    <SolidColorBrush x:Key="CanvasAnchorBrush" Color="#F0A04B"/>
    <SolidColorBrush x:Key="CanvasLabelBrush" Color="#E6E8EC"/>

    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#17181C"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#ECEDEF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#ECEDEF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#9A9EA8"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#C9A45C"/>
