<Window x:Class="EqlLoadouts.App.RestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restore a backup"
        Width="900"
        Height="640"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="13">
    <Window.Resources>
        <HierarchicalDataTemplate x:Key="RestoreNode" ItemsSource="{Binding Children}">
            <DockPanel>
                <CheckBox DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center"
                          Visibility="{Binding CheckVisibility}"
                          AutomationProperties.Name="{Binding CheckName}"
                          IsThreeState="True" IsChecked="{Binding IsChecked, Mode=OneWay}"
                          Focusable="True"
                          PreviewMouseLeftButtonDown="Check_PreviewMouseDown"
                          PreviewKeyDown="Check_PreviewKeyDown"/>
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </DockPanel>
        </HierarchicalDataTemplate>
        <Style x:Key="RestoreTreeItem" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="Row" CornerRadius="6" Padding="4,3" Margin="0,1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <ToggleButton x:Name="Expander" DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,4,0"
                                                  Focusable="False" ClickMode="Press"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <TextBlock x:Name="Glyph" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource MutedBrush}"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Glyph" Property="Text" Value="&#xE70D;"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <ItemsPresenter x:Name="Children" Margin="18,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="Children" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel Margin="20,18,20,16">
        <TextBlock DockPanel.Dock="Top" Text="Restore a backup" FontSize="15" FontWeight="SemiBold"/>
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,8,0,12"
                   Text="Check a server and character to include every loadout in that backup, or check individual loadouts. A restore uses FULL or MODIFIED, not both. Character restores macros and spell loadouts. Windows restores the UI file."/>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Restore" MinWidth="96" IsDefault="True" Click="Restore_Click"/>
            <Button Content="Cancel" MinWidth="88" IsCancel="True" HorizontalAlignment="Left"/>
        </DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <TextBlock x:Name="ChoicePrompt" Text="Check the loadouts to restore." Foreground="{DynamicResource MutedBrush}"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <CheckBox x:Name="CharacterBox" Content="Character"/>
                <CheckBox x:Name="WindowsBox" Content="Windows" Margin="16,0,0,0"/>
            </StackPanel>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button x:Name="FullSort" DockPanel.Dock="Right" Content="&#x2193;" Width="32" Height="32" Padding="0" FontSize="14" Click="FullSort_Click"
                            ToolTip="Sorted descending. Click to reverse."/>
                    <TextBlock Text="FULL" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <TreeView x:Name="FullTree" ItemTemplate="{StaticResource RestoreNode}" ItemContainerStyle="{StaticResource RestoreTreeItem}"
                          VirtualizingStackPanel.IsVirtualizing="False"
                          Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" Padding="4"/>
            </DockPanel>
            <DockPanel Grid.Column="2">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button x:Name="ModifiedSort" DockPanel.Dock="Right" Content="&#x2193;" Width="32" Height="32" Padding="0" FontSize="14" Click="ModifiedSort_Click"
                            ToolTip="Sorted descending. Click to reverse."/>
                    <TextBlock Text="MODIFIED" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <TreeView x:Name="ModifiedTree" ItemTemplate="{StaticResource RestoreNode}" ItemContainerStyle="{StaticResource RestoreTreeItem}"
                          VirtualizingStackPanel.IsVirtualizing="False"
                          Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" Padding="4"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
