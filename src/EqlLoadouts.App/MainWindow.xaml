                                        <Grid>
                                            <DockPanel Margin="10,8" Visibility="{Binding SpellDetailsExpanded, Converter={StaticResource BoolToVisible}}">
                                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                                    <Button Style="{StaticResource IconButton}" Width="22" Height="22" FontSize="10" Margin="0,0,4,0"
                                                            Content="{Binding SpellDetailsChevron}"
                                                            AutomationProperties.Name="{Binding SpellDetailsExpandLabel}"
                                                            ToolTip="{Binding SpellDetailsExpandLabel}"
                                                            Click="ToggleSpellDetails_Click"/>
                                                    <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="Details"/>
                                                </StackPanel>
                                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                    <ContentControl Content="{Binding DisplayedSpellDetail}"
                                                                    ContentTemplate="{StaticResource SpellDetailTemplate}"
                                                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                                                                    Focusable="False" IsTabStop="False"/>
                                                </ScrollViewer>
                                            </DockPanel>
                                            <Button Style="{StaticResource SpellPanelRail}"
                                                    Visibility="{Binding SpellDetailsExpanded, Converter={StaticResource InverseBoolToVisible}}"
                                                    ToolTip="{Binding SpellDetailsExpandLabel}"
                                                    AutomationProperties.Name="{Binding SpellDetailsExpandLabel}"
                                                    Click="ToggleSpellDetails_Click">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding SpellDetailsChevron}" FontFamily="{StaticResource IconFont}" FontSize="12" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Details" FontWeight="SemiBold" Margin="0,10,0,0" HorizontalAlignment="Center">
                                                        <TextBlock.LayoutTransform>
                                                            <RotateTransform Angle="-90"/>
                                                        </TextBlock.LayoutTransform>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="8" Padding="0" CornerRadius="6" Width="{Binding SpellUpgradePanelWidth}"
                                            Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <DockPanel Margin="10,8" Visibility="{Binding SpellUpgradeExpanded, Converter={StaticResource BoolToVisible}}">
                                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                                    <Button Style="{StaticResource IconButton}" Width="22" Height="22" FontSize="10" Margin="0,0,4,0"
                                                            Content="{Binding SpellUpgradeChevron}"
                                                            AutomationProperties.Name="{Binding SpellUpgradeExpandLabel}"
                                                            ToolTip="{Binding SpellUpgradeExpandLabel}"
                                                            Click="ToggleSpellUpgrade_Click"/>
                                                    <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="Spell Upgrade"/>
                                                </StackPanel>
                                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                    <ContentControl Content="{Binding DisplayedSpellUpgrade}"
                                                                    ContentTemplate="{StaticResource SpellDetailTemplate}"
                                                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                                                                    Focusable="False" IsTabStop="False"/>
                                                </ScrollViewer>
                                            </DockPanel>
                                            <Button Style="{StaticResource SpellPanelRail}"
                                                    Visibility="{Binding SpellUpgradeExpanded, Converter={StaticResource InverseBoolToVisible}}"
                                                    ToolTip="{Binding SpellUpgradeExpandLabel}"
                                                    AutomationProperties.Name="{Binding SpellUpgradeExpandLabel}"
                                                    Click="ToggleSpellUpgrade_Click">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding SpellUpgradeChevron}" FontFamily="{StaticResource IconFont}" FontSize="12" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Spell Upgrade" FontWeight="SemiBold" Margin="0,10,0,0" HorizontalAlignment="Center">
                                                        <TextBlock.LayoutTransform>
                                                            <RotateTransform Angle="-90"/>
                                                        </TextBlock.LayoutTransform>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    </Grid>
                                    </ScrollViewer>
                                </DockPanel>
                            </Grid>
                        </TabItem>
                        <TabItem x:Name="StructuredTab" Header="Hotbar" Visibility="{Binding ShowHotbar, Converter={StaticResource BoolToVisible}}">
                            <Grid>
                                <DockPanel Visibility="{Binding ShowHotbar, Converter={StaticResource BoolToVisible}}" Margin="0,8,0,0">
                                    <ComboBox DockPanel.Dock="Top" Style="{StaticResource LabeledComboBox}" Tag="Page" Width="120" HorizontalAlignment="Left" Margin="0,0,0,8"
                                              ItemsSource="{Binding HotbarPages}" SelectedItem="{Binding SelectedHotbarPage}"/>
                                    <ListBox DockPanel.Dock="Top" Height="150" ItemsSource="{Binding HotbarSlots}" SelectedItem="{Binding SelectedHotbar}">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="110" Height="36" Margin="2" Background="{DynamicResource SurfaceAlt}" CornerRadius="4">
                                                    <TextBlock Text="{Binding Caption}" VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <UniformGrid DataContext="{Binding SelectedHotbar}" Columns="2" VerticalAlignment="Top" Margin="0,8,0,0">
                                        <TextBox Style="{StaticResource LabeledTextBox}" Tag="Label" Margin="0,0,8,8" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Style="{StaticResource LabeledTextBox}" Tag="Stored value" Margin="0,0,0,8" Text="{Binding Raw, UpdateSourceTrigger=PropertyChanged}"/>
                                    </UniformGrid>
                                </DockPanel>
                            </Grid>
                        </TabItem>
                        <TabItem x:Name="RawTab" Header="Raw keys" Visibility="{Binding ShowRaw, Converter={StaticResource BoolToVisible}}">
                            <DockPanel Margin="0,8,0,0">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="Delete key" Click="DeleteRaw_Click"/>
                                </StackPanel>
                                <DataGrid x:Name="RawGrid" ItemsSource="{Binding RawRows}" SelectedItem="{Binding SelectedRaw}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" Sorting="RawGrid_Sorting">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn x:Name="RawKeyColumn" Header="Key" SortDirection="Ascending"
                                                            Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="260"/>
                                        <DataGridTextColumn x:Name="RawValueColumn" Header="Value"
                                                            Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Grid>
        </DockPanel>
        <Border x:Name="FullScreenHost" Visibility="Collapsed" Background="{DynamicResource WindowBackground}" Padding="8"/>
    </Grid>
</Window>
