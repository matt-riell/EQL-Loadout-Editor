                            <ItemsPresenter>
                                <ItemsPresenter.OpacityMask>
                                    <VisualBrush Visual="{Binding ElementName=Mask}"/>
                                </ItemsPresenter.OpacityMask>
                            </ItemsPresenter>
                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" IsHitTestVisible="False"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

