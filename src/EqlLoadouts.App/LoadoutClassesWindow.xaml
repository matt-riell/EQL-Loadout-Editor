<Window x:Class="EqlLoadouts.App.LoadoutClassesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose classes"
        Width="640"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="13">
    <StackPanel Margin="20,18,20,16">
        <TextBlock Text="Choose 3 classes" FontSize="15" FontWeight="SemiBold"/>
        <TextBlock x:Name="BodyText" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <TextBlock x:Name="PredictionText" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource MutedBrush}" Visibility="Collapsed"/>
        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="LevelBox" Grid.Column="0" Style="{StaticResource LabeledTextBox}" Tag="Level" Margin="0,0,8,0"
                     MaxLength="3" TextChanged="Level_Changed"/>
            <UniformGrid Grid.Column="1" Columns="3">
                <ComboBox x:Name="Class1" Style="{StaticResource LabeledComboBox}" Tag="Class 1"
                          DisplayMemberPath="Text" SelectedValuePath="Index" SelectionChanged="Class_Changed"/>
                <ComboBox x:Name="Class2" Style="{StaticResource LabeledComboBox}" Tag="Class 2" Margin="8,0,0,0"
                          DisplayMemberPath="Text" SelectedValuePath="Index" SelectionChanged="Class_Changed"/>
                <ComboBox x:Name="Class3" Style="{StaticResource LabeledComboBox}" Tag="Class 3" Margin="8,0,0,0"
                          DisplayMemberPath="Text" SelectedValuePath="Index" SelectionChanged="Class_Changed"/>
            </UniformGrid>
        </Grid>
        <TextBlock x:Name="Note" Text="Choose 3 different classes." FontSize="11" Foreground="{DynamicResource WarningBrush}"
                   Margin="0,10,0,0" Visibility="Collapsed"/>
        <DockPanel Margin="0,18,0,0">
            <Button x:Name="ContinueButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Continue"
                    MinWidth="96" IsDefault="True" IsEnabled="False" Click="Continue_Click"/>
            <Button x:Name="DebugButton" DockPanel.Dock="Left" Content="DEBUG" MinWidth="72" Margin="0,0,8,0"
                    Visibility="Collapsed" Click="Debug_Click"
                    ToolTip="Show the spell name, class, and spell count used to preselect the classes"/>
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="88" IsCancel="True" HorizontalAlignment="Left"/>
        </DockPanel>
        <TextBox x:Name="DebugText" MaxHeight="240" Margin="0,12,0,0" Visibility="Collapsed"
                 IsReadOnly="True" IsTabStop="False" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Padding="8"
                 BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource Surface}"/>
    </StackPanel>
</Window>
