<UserControl x:Class="EqlLoadouts.App.Controls.LayoutCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource CanvasFrameBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
        <Grid>
            <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False"
                          PreviewMouseWheel="Scroller_PreviewMouseWheel" SizeChanged="Scroller_SizeChanged">
                <Grid x:Name="Surface" Margin="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.LayoutTransform>
                        <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1"/>
                    </Grid.LayoutTransform>
                    <Canvas x:Name="Screen" Background="{DynamicResource CanvasBackground}"/>
                    <Canvas x:Name="Overlay" IsHitTestVisible="False"/>
                </Grid>
            </ScrollViewer>
            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,22" Padding="2"
                    Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Content="&#xE71F;" Click="ZoomOut_Click" ToolTip="Zoom out (scroll wheel down)"/>
                    <Button x:Name="ZoomText" Style="{StaticResource IconButton}" Width="52" FontFamily="Segoe UI" FontSize="12" Content="100%"
                            Click="ActualSize_Click" ToolTip="Show at actual game size (100%)"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8A3;" Click="ZoomIn_Click" ToolTip="Zoom in (scroll wheel up)"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE9A6;" Click="Fit_Click" ToolTip="Fit the whole screen in view"/>
                    <Button x:Name="FullScreenButton" Style="{StaticResource IconButton}" Content="&#xE740;" Click="FullScreen_Click" ToolTip="Full screen (F12)"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
